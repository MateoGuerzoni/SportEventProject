@using Dominio
@model List<Jugador>


<a href="~/Usuario/Index" class="btn btn-primary">Volver a selecciones</a>
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th scope="col">Nombre Jugador</th>
                <th scope="col">Numero camiseta</th>

</thead>
        <tbody>
            @foreach (Jugador unJugador in Model)
            {
                <tr>
                    <th scope="row">@unJugador.Nombre</th>
                    <td>@unJugador.NumeroCamiseta</td>




                </tr>
            }
        </tbody>
    </table>
