@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mundial Web</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                @if (@Context.Session.GetString("TipoUsuario") == "Periodista")
                {


                    <a class="navbar-brand" asp-area="" asp-controller="Periodista" asp-action="VerOpcionesPeriodista">Mundial Web</a>


                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                }
                else if (@Context.Session.GetString("TipoUsuario") == "Operador")
                {
                    <a class="navbar-brand" asp-area="" asp-controller="Operador" asp-action="MostrarOpciones">Mundial Web</a>
                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>


                }

                <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!String.IsNullOrWhiteSpace(@Context.Session.GetString("loggedname")))
                        {
                           
                            @if (@Context.Session.GetString("loggedname") == "Periodista")
                            {


                                <li>
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Login" asp-action="Logout">Logout</a>
                                </li>


                                <li>
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Periodista" asp-action="VistaPartidosFinalizados">Ver partidos finalizados</a>
                                </li>


                                <li>
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Periodista" asp-action="FiltrarReseña">Ver Reseñas</a>
                                </li>

                            }
                            else
                            {
                                <li>
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Login" asp-action="Logout">Logout</a>
                                </li>

                            }



                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2022 - MundialWeb - <a asp-area="" asp-controller="Periodista" asp-action="Index">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
